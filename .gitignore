.venv/
.uv-cache/
.env

# Локальная база и рабочие данные
data/
data-old/

# Кэш и байткод Python
__pycache__/
*.py[cod]

# Служебные файлы сборки и editable-установки
*.egg-info/
build/
dist/

# Снимки и логи Playwright MCP, если сервер запущен вне data/logs
.playwright-mcp/

# Кэши инструментов разработки
.pytest_cache/
.pytest_tmp*/
.mypy_cache/
.ruff_cache/

# Локальная память пользователя, если выбран путь внутри репозитория
/memory/
