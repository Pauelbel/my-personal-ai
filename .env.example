# Основной OpenAI-compatible сервер: LM Studio (http://127.0.0.1:1234/v1), Ollama (http://127.0.0.1:11434/v1), vLLM и т. п.
# Адрес обязательно с /v1 на конце. LLM_NAME — подпись сервера в интерфейсе.
LLM_BASE_URL=http://127.0.0.1:1234/v1
LLM_NAME=Локальный сервер
# Дополнительные OpenAI-compatible серверы, JSON-список; для облака добавьте "api_key".
# LLM_PROVIDERS=[{"id":"ollama","name":"Ollama","base_url":"http://127.0.0.1:11434/v1"}]
# ID модели ровно в том виде, в каком его отдаёт GET <адрес>/v1/models, без своих префиксов.
DEFAULT_MODEL=google/gemma-4-12b
LLM_TIMEOUT_SECONDS=120

# Окно модели, если сервер его не сообщает (LM Studio и Ollama сообщают сами), и запас токенов под ответ.
DEFAULT_CONTEXT_TOKENS=8192
RESPONSE_RESERVE_TOKENS=1024
MAX_CONTEXT_MESSAGES=20

# Память: сколько символов (профиль и найденные по сообщению записи) попадает в промпт.
MAX_MEMORY_CONTEXT_CHARS=800
# Модель для разбора разговора в память; пусто — модель сессии.
MEMORY_MODEL=
# Разбирать разговор в память после стольких новых реплик пользователя; 0 — только по кнопке.
MEMORY_AUTO_UPDATE_MESSAGES=10

# Саб-агенты: сколько задач выполняется одновременно.
MAX_PARALLEL_TASKS=2
# Отдельная модель для саб-агентов, чтобы они не ждали основную: id провайдера из LLM_PROVIDERS и ID модели.
# Пусто — модель сессии, которая поручила задачу.
SUBAGENT_PROVIDER=
SUBAGENT_MODEL=
# MCP-серверы из data/mcp.json (веб-поиск, браузер Playwright) запускаются при старте.
MCP_ENABLED=true

# Данные. Пути относительно корня проекта; папка data/ исключена из Git.
AGENTS_PATH=data/agents
SKILLS_PATH=data/skills
SESSIONS_PATH=data/sessions
PROJECTS_PATH=data/projects
CONVERSATIONS_PATH=data/conversations
MEMORY_PATH=data/memory
DRAFTS_PATH=data/drafts
# Остальное по умолчанию лежит рядом, в папке над SESSIONS_PATH:
# TOOLS_PATH=data/tools  WIKI_PATH=data/wiki  INDEX_PATH=data/index
# CHECKPOINTS_PATH=data/checkpoints.sqlite  MCP_CONFIG_PATH=data/mcp.json  LOGS_PATH=data/logs

LOG_LEVEL=INFO
ALLOWED_HOSTS=127.0.0.1,localhost
