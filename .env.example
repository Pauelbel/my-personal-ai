# OpenAI-совместимый сервер модели: LM Studio (http://127.0.0.1:1234/v1) или Ollama (http://127.0.0.1:11434/v1).
# Адрес обязательно с /v1 на конце. Сервер и модель можно поменять и в разделе «Настройки».
LLM_BASE_URL=http://127.0.0.1:1234/v1
# Ключ нужен только если сервер его требует.
LLM_API_KEY=
# ID модели ровно в том виде, в каком его отдаёт GET <адрес>/v1/models.
DEFAULT_MODEL=google/gemma-4-12b
LLM_TIMEOUT_SECONDS=120
LLM_VERIFY_SSL=true

# Где слушает Мипо.
HOST=127.0.0.1
PORT=8000
# Папка данных (сессии, скиллы, память, вики); путь относительно корня репозитория.
DATA_PATH=data
