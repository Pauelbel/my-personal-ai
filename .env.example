# Необязательная настройка модели через окружение. Обычно подключение добавляют в интерфейсе.
# Поддерживается локальный или внешний OpenAI-совместимый API; адрес обычно заканчивается на /v1.
LLM_BASE_URL=
# Ключ нужен только внешнему серверу, который требует авторизацию.
LLM_API_KEY=
# ID модели ровно в том виде, в каком его отдаёт GET <адрес>/models.
DEFAULT_MODEL=
LLM_TIMEOUT_SECONDS=120
LLM_VERIFY_SSL=true

# Где слушает Мипо.
HOST=127.0.0.1
PORT=8000
# Папка данных (сессии, скиллы, память, вики); путь относительно корня репозитория.
DATA_PATH=data
